      "type": "string",
      "description": "Zugeh\u00f6riger Neuro-Drill"
    },
    "neuro_instruction": {
      "type": "string",
      "description": "Anleitung f\u00fcr den Neuro-Drill"
    },
    "body_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Betroffene K\u00f6rperregionen"
    },
    "color": {
      "type": "string",
      "description": "Farbcode f\u00fcr UI-Darstellung"
    },
    "image_url": {
      "type": "string",
      "description": "URL zur visuellen Darstellung der myofaszialen Leitbahn"
    }
  },
  "required": [
    "code",
    "name_de",
    "test_name",
    "neuro_marker"
  ],
  "rls": {
