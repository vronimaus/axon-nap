    },
    "name_de": {
      "type": "string",
      "description": "Deutscher Name der Kette"
    },
    "name_en": {
      "type": "string",
      "description": "Englischer Name"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung der Kette und ihrer Funktion"
    },
    "test_name": {
      "type": "string",
      "description": "Name des Hardware-Tests"
    },
    "test_instruction": {
      "type": "string",
      "description": "Detaillierte Testanleitung"
    },
    "test_positive_indicator": {
      "type": "string",
