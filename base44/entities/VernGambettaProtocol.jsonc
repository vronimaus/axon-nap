{
  "name": "VernGambettaProtocol",
  "type": "object",
  "properties": {
    "exercise_id": {
      "type": "string",
      "description": "Foreign Key zur Exercise Entity"
    },
    "movement_foundation": {
      "type": "string",
      "enum": [
        "running",
        "jumping",
        "throwing",
        "change_of_direction",
        "acceleration",
        "deceleration",
        "lateral_movement",
        "stability"
      ],
      "description": "Fundamentales Bewegungs-Pattern nach Vern Gambetta"
    },
    "energy_system": {
      "type": "string",
      "enum": [
        "atp_pc",
        "anaerobic_glycolytic",
        "aerobic",
        "mixed"
      ],
      "description": "Energie-System das trainiert wird"
    },
    "velocity_profile": {
      "type": "string",
      "enum": [
        "max_velocity",
        "acceleration_velocity",
        "power_velocity",
        "submaximal"
      ],
      "description": "Geschwindigkeitsprofil f\u00fcr explosives Training"
    },
    "training_method": {
      "type": "string",
      "description": "Vern Gambetta's Trainings-Methode (z.B. 'Complex Training', 'Contrast Method')"
    },
    "velocity_target": {
      "type": "string",
      "description": "Ziel-Geschwindigkeit oder Explosivit\u00e4t (z.B. 'Max Velocity', 'Power Output')"
    },
    "sets_reps_tempo": {
      "type": "string",
      "description": "Sets x Reps mit Tempo (z.B. '3x5 @ 90%', '5x2 explosive')"
    },
    "recovery_period": {
      "type": "string",
      "description": "Erholung zwischen Sets f\u00fcr dieses Energie-System"
    },
    "athletic_quality": {
      "type": "string",
      "enum": [
        "strength",
        "power",
        "speed",
        "agility",
        "conditioning",
        "resilience"
      ],
      "description": "Athletic Quality die entwickelt wird"
    },
    "movement_screening_component": {
      "type": "string",
      "description": "Wie diese \u00dcbung als Bewegungs-Screening Element verwendet wird"
    },
    "vern_gambetta_insight": {
      "type": "string",
      "description": "Wissenschaftlicher/Philosophischer Hintergrund nach Vern Gambetta"
    },
    "countermovement_emphasis": {
      "type": "boolean",
      "default": false,
      "description": "Ist Countermovement (reactive/elastic) ein Kern-Element?"
    },
    "notes": {
      "type": "string",
      "description": "Zus\u00e4tzliche Vern Gambetta-spezifische Notizen"
    }
  },
  "required": [
    "exercise_id",
    "movement_foundation",
    "energy_system",
    "athletic_quality"
  ]
}