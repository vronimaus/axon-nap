{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name der Person (z.B. 'Marcus K.')"
    },
    "role": {
      "type": "string",
      "description": "Sport/Rolle (z.B. 'BJJ Athlet', 'CrossFit Coach', 'Triathlet')"
    },
    "quote": {
      "type": "string",
      "description": "Das Testimonial-Zitat \u2014 authentisch, konkret, 2-4 S\u00e4tze"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 5,
      "description": "Sterne-Bewertung (1-5)"
    },
    "avatar_url": {
      "type": "string",
      "description": "Optionale URL zum Profilbild (Unsplash oder Upload)"
    },
    "is_featured": {
      "type": "boolean",
      "default": true,
      "description": "Auf der Landingpage anzeigen?"
    },
    "order": {
      "type": "integer",
      "default": 1,
      "description": "Anzeigereihenfolge (1 = oben)"
    }
  },
  "required": [
    "name",
    "role",
    "quote"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}